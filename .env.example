# Copier ce fichier en .env avant de lancer : docker compose up --build

DB_PASSWORD=changeme
DB_ROOT_PASSWORD=changeme

# Cle de signature des jetons. Generer une chaine aleatoire longue :
#   openssl rand -base64 48
JWT_SECRET=changeme-generate-your-own-random-secret

# URL publique de l'API et du front, telles que le navigateur les voit (sans "/" final).
# Si le projet n'est pas sur localhost, mettre ici les vraies adresses.
API_URL=http://localhost:8080
FRONTEND_URL=http://localhost:8081

# Autres fronts autorises a appeler l'API (CORS) et a figurer dans les liens des emails,
# separes par des virgules, sans "/" final. Un lien d'email reprend l'adresse du front qui a
# envoye la demande si elle est dans cette liste ; sinon c'est FRONTEND_URL.
ALLOWED_FRONT_URLS=

# Envoi des emails (activation de compte, mot de passe oublie) via Brevo.
# Sans ces valeurs, l'application tourne mais n'envoie aucun email.
BREVO_SMTP_LOGIN=
BREVO_SMTP_KEY=
