# Copier ce fichier en .env et renseigner les valeurs reelles.
# .env est ignore par git (voir .gitignore) : ne jamais y commiter de vrais secrets.

# --- Profil actif ---
SPRING_PROFILES_ACTIVE=dev

# --- Base de donnees MariaDB 11.6.2 ---
SPRING_DATASOURCE_URL=jdbc:mariadb://localhost:3306/hub_evenementiel
SPRING_DATASOURCE_USERNAME=hub_evenementiel_app
SPRING_DATASOURCE_PASSWORD=changeme

# --- Serveur ---
SERVER_PORT=8080
# URL publique du front, utilisee pour construire les liens envoyes par email
# (activation de compte RG01/RG02, confirmation de mot de passe RG09).
APP_BASE_URL=http://localhost:4200

# --- Service d'envoi d'emails (US-004) ---
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=changeme
MAIL_PASSWORD=changeme
MAIL_FROM=no-reply@hub-evenementiel.example.com

# --- Jetons de verification (activation de compte, changement de mot de passe) ---
# Duree de validite en minutes.
TOKEN_EXPIRATION_MINUTES=60

# --- MongoDB (vue de lecture du catalogue) ---
# Perimetre non tranche a ce stade (voir docs/backlog.md). A activer une fois decide.
# SPRING_DATA_MONGODB_URI=mongodb://localhost:27017/hub_evenementiel_catalogue
